{
  "base": "base.json",
  "init_checkpoint": "checkpoints/pretrain_clean_max600.pt",
  "epochs": 1000,
  "batch_size": 4,
  "pretrain_learning_rate": 0.0001,
  "adapter_learning_rate": 0.001,
  "weight_decay": 0.01,
  "pos_weight": 5.0,
  "soft_f1_weight": 0.12,
  "train": [
    {"file": "data/RNAStralign/train_max600.pickle", "mask_dir": "data/RNAStralign"}
  ],
  "evaluation": {
    "name": "RNAStralign validation",
    "file": "data/RNAStralign/val_max600.pickle",
    "mask_dir": "data/RNAStralign"
  },
  "test": {
    "name": "ArchiveII test",
    "datasets": [
      {"file": "data/ArchiveII/all_max600.pickle", "mask_dir": "data/ArchiveII"}
    ]
  },
  "output_dir": "logs/finetune/archiveii"
}
